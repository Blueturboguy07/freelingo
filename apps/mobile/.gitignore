# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# A local Expo module's ios/ and android/ folders are SOURCE, not a prebuild output.
# The repo-root .gitignore excludes every directory named ios/ or android/ at any depth
# (INV-PLAT-02), which would silently swallow them — the module would build here and be
# missing for everyone else. Re-include them: this file is deeper, so it wins. Git cannot
# re-include a file whose parent directory is excluded, so the directories are named too.
!modules/*/ios/
!modules/*/android/
