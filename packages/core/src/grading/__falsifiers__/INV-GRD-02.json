      "pack": "es",
      "mistypedWord": "gatto",
      "targetWord": "gato",
      "targetString": "gato",
      "editOffsetInTarget": 3,
      "targetLexemeSurface": "gato",
      "guards": {
        "rejectRealTargetWord": true,
        "rejectEditOnTargetLexeme": false,
        "minimumLength": 0
      },
      "expect": {
        "forgiven": true,
        "rejectedBy": []
      }
    },
    {
      "note": "gatto/gato, guard 2 alone: reproduces it",
      "pack": "es",
      "mistypedWord": "gatto",
      "targetWord": "gato",
      "targetString": "gato",
      "editOffsetInTarget": 3,
      "targetLexemeSurface": "gato",
      "guards": {
        "rejectRealTargetWord": false,
        "rejectEditOnTargetLexeme": true,
        "minimumLength": 0
      },
      "expect": {
        "forgiven": false,
        "rejectedBy": ["edit-on-target-lexeme"]
      }
    },
    {
      "note": "gatto/gato, guard 3 alone: reproduces it",
      "pack": "es",
      "mistypedWord": "gatto",
      "targetWord": "gato",
      "targetString": "gato",
      "editOffsetInTarget": 3,
      "targetLexemeSurface": "gato",
      "guards": {
        "rejectRealTargetWord": false,
        "rejectEditOnTargetLexeme": false,
        "minimumLength": 5
