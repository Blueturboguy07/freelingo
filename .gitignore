# --- node ---
node_modules/
*.log
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/
package-lock.json
yarn.lock

# --- build output ---
dist/
build/
coverage/
*.tsbuildinfo
.stryker-tmp/
reports/

# --- expo ---
.expo/
.expo-shared/
expo-env.d.ts
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# --- native trees are generated by `expo prebuild`, never committed (INV-PLAT-02) ---
apps/mobile/ios/
apps/mobile/android/
ios/
android/

# --- python / uv ---
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
.ruff_cache/
.pytest_cache/
*.egg-info/

# --- e2e artefacts: only CI writes these (build workflow step 3) ---
e2e/artifacts/*
!e2e/artifacts/.gitkeep

# --- os / editors ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- secrets ---
.env
.env.*
!.env.example
secrets/
*.pem
