{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "eslint.config.mjs",
    "packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "apps/**"
  ]
}
